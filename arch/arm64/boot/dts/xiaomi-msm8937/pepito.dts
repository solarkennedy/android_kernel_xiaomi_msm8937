/dts-v1/;

#include "common/include/config.h"

#include "qcom/msm8940.dtsi"
/*
 * Pepito's companion PMIC is PMI8950 (per pmic-id = <0x10019 0x20011 ...>,
 * where 0x20011 identifies PMI8950).  The msm8940-pmi8950 fragment also
 * brings in the labibb regulators and wires lab/ibb supplies into
 * mdss_dsi0 — the regulator topology the FT8613 panel needs.
 *
 * The Mi8937 forward-port originally used msm8940-pmi8937.dtsi here
 * (a copy from a sibling that has no PMI), which left the kernel using
 * the wrong PMIC sub-device map and missing the panel supply wiring.
 */
#include "qcom/msm8940-pmi8950.dtsi"

#include "common/fragments/delete-msm89x7-camera-sensor-mtp.dtsi"
#include "common/fragments/qti-haptics.dtsi"
#include "common/fragments/restore-old-msm8937-camera-pinctrl.dtsi"

#include "common/common.dtsi"
#include "pepito/pepito.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. MSM8940-PMI8950 Palm PVG100";
	compatible = "qcom,msm8940-pmi8950", "qcom,msm8940", "qcom,pmi8950", "xiaomi,pepito";
	qcom,board-id = <0xaa000008 0x00 0x08 0x00>;
	qcom,pmic-id = <0x10019 0x20011 0x0 0x0>;

#ifndef MI8937_V2
	xiaomi,series = "pepito";
	xiaomi,device = "pepito";
#endif
};

/*
 * SMMU re-enable (2026-06-03): the prior surgical-disable plan in
 * PLAN.md §3.1b was based on the theory that stock TZ couldn't tolerate
 * the qsmmu-v500 driver. Subsequent investigation (PLAN.md §3.1h) showed
 * that the kernel_src 4.9.227 kernel which "barely booted" on stock
 * Android 8 used the SAME arm-smmu.c driver and the SAME qcom,smmu-v2 +
 * qcom,qsmmu-v500 DTS bindings we have now. The SMMU was therefore not
 * the actual root cause of the silent reset at populate_rootfs — the
 * cause is somewhere else (SCM layer / DMA / init ordering — under
 * investigation). The apps_iommu / kgsl_smmu / msm_vidc / cam_smmu
 * disables are dropped here. Their inherited 4.9-tree configuration in
 * vendor-legacy/qcom/msm-arm-smmu-8937.dtsi is essentially identical to
 * what worked on 4.9, so no DTS additions are needed — only undoing the
 * status="disabled" overrides.
 *
 * i2c_2 stays disabled below — that issue is unrelated to SMMU.
 */

/*
 * BLSP1 QUP2 (i2c_2 @ 0x78b6000) is enabled by vendor-legacy/qcom/
 * msm8937-audio.dtsi for the WSA881x speaker codecs.  Lineage's
 * common/audio.dtsi then /delete-node/s those codec children, and
 * pepito has no other consumers on this bus — stock 4.9 pepito DTS
 * leaves &i2c_2 untouched (no wusb3801, no sensors, nothing).  USB-C
 * orientation on pepito is handled internally by the PMI8950 USBIN
 * block, not a discrete CC controller.
 *
 * With ZERO children to drive, the i2c-msm-v2 driver still runs HW
 * init at probe time and hangs there (likely in BAM/AXI bus-voting
 * setup, despite qcom,disable-dma being set).  Boot stalls at ~7.28s.
 *
 * Disable the bus entirely.  Re-enable here and add child nodes only
 * if some future addition (smart-amp, sensor, etc.) actually needs it.
 */
&i2c_2 {
	status = "disabled";
};

/*
 * other_ext_mem: restore the 30 MiB Palm reservation at 0x84A00000.
 *
 * vendor-legacy/qcom/msm8937.dtsi defines other_ext_mem at
 * 0x85B00000 / 0x0D00000 (13 MiB) — the layout used by post-update
 * Xiaomi TZ blobs on land/santoni/rolex/etc.  Pepito's stock TZ is
 * the older Palm 8.1 image (same root cause family as the SMMU
 * binding drift documented in PLAN.md §3.1b) and still DDR-xPU
 * protects the full 30 MiB region from 0x84A00000 to 0x86800000.
 *
 * Without this override the kernel believes the 17 MiB at
 * 0x84A00000–0x85B00000 is free RAM.  Page-allocator hands out
 * pages from that band during the initramfs-unpack burst in
 * populate_rootfs; the first write into one of those pages trips
 * TZ's xPU, which asserts PS_HOLD at the PMIC.  Result: silent
 * reset bypassing the kernel, no oops/panic visible — exactly the
 * §3.1f signature.
 *
 * Direct evidence: 4.9 boot log shows 2981888K total RAM after
 * reservations, our 4.19 build shows 2999296K — a delta of
 * 17408K = exactly the (0x1E00000 − 0xD00000) gap.
 *
 * Every other Mi8937 variant in this tree already has the same
 * override: ulysse/common/soc.dtsi (ugg) and
 * wingtech/msm8937/common/soc.dtsi (santoni, prada).  Pepito was
 * missed during the forward-port from 4.9.
 */
&other_ext_mem {
	reg = <0x0 0x84A00000 0x0 0x1E00000>;
};
