/*
 * Pepito touch controller — FocalTech FTS family at I2C BLSP1 QUP3 (i2c_3),
 * address 0x38.  Matches stock pepito DTS and the 4.9 bring-up build.
 *
 * The default touchscreen.dtsi from the Mi8937 multi-variant tree declared
 * an Atmel maXTouch (atmel,mxt-ts) at 0x4a — that's correct for several
 * Xiaomi siblings but wrong for pepito.  Replaced here.
 *
 * The 4.19 in-tree driver lives at drivers/input/touchscreen/focaltech_touch/
 * and registers compatible = "focaltech,fts_ts" (note the trailing "_ts" — the
 * driver was renamed from the 4.9-era "focaltech,fts" to disambiguate from
 * mainline FT-series drivers).  Property names, pinctrl state names, and
 * regulator-supply names are unchanged.
 */
&i2c_3 {
	status = "okay";

	focaltech_ts@38 {
		compatible = "focaltech,fts_ts";
		reg = <0x38>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 0x2>;
		vdd-supply = <&pm8937_l10>;
		vcc_i2c-supply = <&pm8937_l6>;
		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		focaltech,reset-gpio = <&tlmm 64 0x0>;
		focaltech,irq-gpio = <&tlmm 65 0x2>;
		focaltech,max-touch-number = <5>;
		focaltech,display-coords = <0 0 720 1280>;
	};
};
